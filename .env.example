# ── Local development ────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=change-me-to-a-long-random-secret-key

# Option A: single connection string (recommended for local dev)
DATABASE_URL=mysql+pymysql://solargrid:solargrid_pass@127.0.0.1:3306/solargrid_db
TEST_DATABASE_URL=mysql+pymysql://solargrid:solargrid_pass@127.0.0.1:3306/solargrid_test_db

# Option B: component variables (alternative to DATABASE_URL)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=solargrid
# DB_PASSWORD=solargrid_pass
# DB_NAME=solargrid_db

SESSION_TIMEOUT_MINUTES=30
BCRYPT_LOG_ROUNDS=12
RATE_LIMIT_LOGIN=5 per minute

# ── Railway production (set in Railway Variables — do NOT commit real values) ─
# FLASK_ENV=production
# FLASK_APP=run.py
# SECRET_KEY=<long-random-string>
#
# Link the MySQL service to the Flask service, then either rely on injected
# MYSQLHOST/MYSQLPORT/MYSQLUSER/MYSQLPASSWORD/MYSQLDATABASE variables, or set:
#
# DB_HOST=${{MySQL.MYSQLHOST}}
# DB_PORT=${{MySQL.MYSQLPORT}}
# DB_USER=${{MySQL.MYSQLUSER}}
# DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
# DB_NAME=${{MySQL.MYSQLDATABASE}}
#
# First admin (used once when the database has no staff users):
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@solargrid.co.zm
# ADMIN_PASSWORD=<strong-production-password>
